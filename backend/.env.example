# Django core
DJANGO_SECRET_KEY=change_this_to_a_long_random_secret_in_production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cookies (set COOKIE_SECURE=True once served over HTTPS in production)
COOKIE_SECURE=False

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Public site URL used in sitemap.xml / robots.txt
PUBLIC_SITE_URL=http://localhost:5173

# JWT
JWT_ACCESS_DAYS=7

# Rate limiting (SRS 5.2: 60 requests/minute/IP on public endpoints)
RATE_LIMIT_ANON=60/min
RATE_LIMIT_USER=120/min

# Database - leave DATABASE_URL blank to use local SQLite.
# Set to a Postgres URL (e.g. from Render/Neon/Supabase free tier) for
# persistent production storage: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Celery (SRS REQ-BE-001 AI Processing Layer)
# True = run prediction tasks in-process (no Redis/worker needed - ideal for
# a single free-tier web service). False = dispatch to a real Celery worker
# via CELERY_BROKER_URL (e.g. a free Upstash/Redis Cloud instance).
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=
REDIS_URL=

# Admin bootstrap account (created via `python manage.py bootstrap_admin`)
ADMIN_EMAIL=admin@finwise.ai
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# Live data sources
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# Optional: get a free key at https://www.goldapi.io or https://metals-api.com if you want real gold prices.
GOLD_API_KEY=
# Optional: get a free key at https://www.alphavantage.co/support/#api-key for real equity prices.
ALPHA_VANTAGE_API_KEY=
